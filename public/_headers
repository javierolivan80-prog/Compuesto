# Cabeceras de Cloudflare Pages (también válidas en Netlify). CLAUDE.md §2.8: seguridad, caché del service worker y URL no indexada.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# El service worker y su interruptor de emergencia nunca se cachean: una versión rota debe poder retirarse al momento.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/sw-control.json
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Archivos con hash en el nombre: inmutables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
